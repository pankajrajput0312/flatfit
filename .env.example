# ==============================================================================
# FLATHIT PLATFORM - CONFIGURATION BLUEPRINT (.env.example)
# ==============================================================================

# System Runtime Mode & Localization
APP_ENV=development                 # Options: development, staging, production
PROJECT_NAME="FlatFit Platform"
TZ=Asia/Kolkata                     # Hard-locks the container OS level to IST

# Security & Cryptographic Shields (Must be replaced with strong unique values)
JWT_SECRET_KEY=replace_with_a_64_character_hex_string_for_access_tokens
JWT_REFRESH_SECRET_KEY=replace_with_a_64_character_hex_string_for_refresh_tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15      # Short-lived for access security
REFRESH_TOKEN_EXPIRE_DAYS=7         # Controlled persistent session window

# Primary Relational Engine (PostgreSQL)
POSTGRES_USER=flatfit_db_user
POSTGRES_PASSWORD=replace_with_a_secure_db_password
POSTGRES_HOST=postgres-db           # Matches the service name in docker-compose
POSTGRES_PORT=5432
POSTGRES_DB=flatfit_dev

# In-Memory Volatility & Leaderboard Deck (Redis)
REDIS_HOST=redis-cache              # Matches the service name in docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_secure_redis_password

# Infrastructure Email Gateway (SMTP Relay)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_your_actual_smtp_relay_key
EMAILS_FROM_EMAIL=no-reply@flatfit.app